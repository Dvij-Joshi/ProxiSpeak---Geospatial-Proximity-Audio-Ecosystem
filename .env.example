# =============================================================================
# ProxiSpeak — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to version control.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/proxispeak
# Atlas:  mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/proxispeak
MONGODB_URI=mongodb://localhost:27017/proxispeak

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL of the React development server (Vite default)
CLIENT_URL=http://localhost:5173

# ── Redis (for multi-node scaling — optional in development) ─────────────────
# Leave blank to skip Redis adapter (single-node mode)
REDIS_URL=redis://localhost:6379

# ── WebRTC / STUN / TURN ──────────────────────────────────────────────────────
# Public STUN server (free Google STUN — fine for development)
STUN_SERVER=stun:stun.l.google.com:19302

# TURN server credentials (required for production behind strict NATs)
# Get a free account at: https://www.metered.ca/tools/openrelay/
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Proximity Settings ────────────────────────────────────────────────────────
# Max distance (in canvas units) for earshot detection
MAX_EARSHOT_DISTANCE=100

# ── Socket.io ─────────────────────────────────────────────────────────────────
# Max events per second per socket (rate limiting)
SOCKET_RATE_LIMIT=20
