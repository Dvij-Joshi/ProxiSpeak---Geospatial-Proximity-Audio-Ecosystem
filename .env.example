# =============================================================================
# ProxiSpeak — Environment Variables Template
# Copy this file to .env:  cp .env.example .env
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas Credentials ─────────────────────────────────────────────────
MONGODB_USERNAME=dvij0905_db_user
MONGODB_PASSWORD=1hruDoW2pDCbo68p
MONGODB_CLUSTER=proxispeakcluster.0fl72gc.mongodb.net
MONGODB_DB_NAME=proxispeak

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://dvij0905_db_user:1hruDoW2pDCbo68p@proxispeakcluster.0fl72gc.mongodb.net/proxispeak?retryWrites=true&w=majority

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL of the React development server (Vite default)
CLIENT_URL=http://localhost:5173

# ── Redis (for multi-node Socket.io — optional in development) ────────────────
# Leave blank to run in single-node mode (no Redis required for local dev)
REDIS_URL=redis://localhost:6379

# ── WebRTC / STUN / TURN ──────────────────────────────────────────────────────
# Free public STUN server — sufficient for local/LAN development
STUN_SERVER=stun:stun.l.google.com:19302

# TURN server — required for production (NAT traversal across networks)
# Free tier available at https://www.metered.ca/tools/openrelay/
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Proximity Settings ────────────────────────────────────────────────────────
# Radius (canvas units) within which users can hear each other
MAX_EARSHOT_DISTANCE=100

# ── Socket.io ─────────────────────────────────────────────────────────────────
# Maximum socket events accepted per second per connection (rate limiting)
SOCKET_RATE_LIMIT=20
