{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://proxispeak-server-sgwp.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://proxispeak-server-sgwp.onrender.com/health"
    },
    {
      "source": "/dashboard",
      "destination": "/app.html"
    },
    {
      "source": "/designer",
      "destination": "/app.html"
    },
    {
      "source": "/organizations",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
